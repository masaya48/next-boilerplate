{
  "name": "next-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "npm run lint --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:ci": "vitest --run",
    "e2e": "playwright test --ui",
    "e2e:ci": "playwright test",
    "format": "prettier --write .",
    "fix": "npm run format && npm run lint:fix",
    "generate:api": "sh bin/generate.sh",
    "generate:component": "scaffdog generate component",
    "knip": "knip",
    "postinstall": "typesync --ignore-deps"
  },
  "dependencies": {
    "@hookform/resolvers": "3.3.4",
    "autoprefixer": "10.4.17",
    "destyle.css": "4.0.1",
    "next": "14.1.0",
    "postcss": "8.4.35",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.50.1",
    "tailwindcss": "3.4.1",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.2",
    "@eslint/js": "^10.0.0",
    "@next/eslint-plugin-next": "^16.0.0",
    "@playwright/test": "^1.42.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/addon-links": "^10.0.0",
    "@storybook/nextjs": "^10.0.0",
    "@storybook/react": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@types/eslint": "~9.6.0",
    "@types/eslint-config-prettier": "~6.11.3",
    "@types/eslint__eslintrc": "~3.3.0",
    "@types/eslint__js": "~9.14.0",
    "@types/jsdom": "~28.0.0",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "10.2.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-import-access": "^3.0.0",
    "eslint-plugin-playwright": "^2.0.0",
    "eslint-plugin-storybook": "^10.0.0",
    "eslint-plugin-testing-library": "^7.0.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "eslint-plugin-vitest": "^0.3.22",
    "jsdom": "^29.0.0",
    "knip": "^6.0.0",
    "prettier": "3.2.5",
    "scaffdog": "^4.0.0",
    "storybook": "^10.0.0",
    "typescript": "6.0.3",
    "typesync": "^0.12.1",
    "vitest": "^4.0.0"
  }
}
